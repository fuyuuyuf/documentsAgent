# =============================================================================
#  文档解析智能体 · 论文阅读助手 —— 环境变量示例
# =============================================================================
#
#  使用方法：
#      1. 复制本文件为 .env（同一目录，即项目根目录）
#             Windows PowerShell :  Copy-Item .env.example .env
#             macOS / Linux      :  cp .env.example .env
#      2. 打开 .env，把 LLM_API_KEY 填成你自己的密钥（只填这一项即可跑通）
#      3. 运行：python src/main.py 你的论文.pdf
#
#  ⚠️ 重要警告
#    · 本文件是"示例模板"，里面的密钥一律留空 / 写占位符。
#    · 真实的 API Key 只能写在 .env 里，绝对不要提交到 Git、不要把 .env 打包进提交的 zip。
#    · 更不要把 Key 硬编码进任何 .py 源码 —— 这是比赛"工程规范"评分的明确扣分点。
#    · 如果 Key 曾经被提交或截图外泄，请立刻到服务商控制台吊销并重新生成。
#    · .env 已在 .gitignore 中忽略；提交前可用 `git status` 再确认一次没有 .env。
#
#  没有任何 API Key 也想看效果？不需要改本文件，直接跑离线演示模式：
#      python src/main.py examples/sample_en_two_column.pdf --mock
# =============================================================================


# -----------------------------------------------------------------------------
#  一、大模型配置（对应 src/config.py 的 Settings）
# -----------------------------------------------------------------------------

# 【必填】大模型 API 密钥。留空表示未配置，此时只能使用 --mock 离线演示模式。
#         若本机已存在 OPENAI_API_KEY 环境变量，它会被自动识别为兜底并给出提示。
LLM_API_KEY=

# 【可选·兜底】OPENAI_API_KEY 仅在 LLM_API_KEY 为空时生效（见 src/config.py 的 from_env）。
#         用官方 OpenAI 接口时可以改用这一项；平时保持注释即可。
# OPENAI_API_KEY=

# 【必填】OpenAI 兼容接口的 Base URL。必须以 http:// 或 https:// 开头，
#         否则启动时会直接报"LLM_BASE_URL 不是合法 URL"。
#         注意：不同服务商的路径后缀不同（有的带 /v1，有的带 /v4 或 /compatible-mode/v1），
#         请务必以你所用服务商的最新官方文档为准。下方第五节给了几个可直接复制的预设。
LLM_BASE_URL=https://api.deepseek.com/v1

# 【必填】模型名称。必须是该服务商真实存在的模型 ID，写错会返回 404。
LLM_MODEL=deepseek-v4-pro
LLM_THINKING=disabled

# 【可选】采样温度。默认 0.2 —— 论文分析需要稳定、少发挥，不建议调到 0.7 以上。
LLM_TEMPERATURE=0.2

# 【可选】单次回复的最大 token 数。默认 8192。
#         结构化 JSON 较长（含 contributions / method / glossary 等数组），不要调得太小，
#         否则 JSON 会被截断，导致"无法解析出 JSON"。
LLM_MAX_TOKENS=8192

# 【可选】单次请求超时秒数。默认 180。
#         长论文分析通常 30-120 秒；若你用的模型较慢或网络较差，可调大到 300。
LLM_TIMEOUT=180

# 【可选】失败自动重试次数（不含首次请求）。默认 2。
#         仅对 429 限流 / 5xx / 超时 / 网络抖动等瞬时错误重试，按指数退避：
#         第 1 次重试等 LLM_RETRY_BASE_DELAY 秒，之后逐次翻倍（默认 2s → 4s → 8s）。
#         401/403/404、余额不足等确定性错误不会重试，直接给出中文报错。
LLM_MAX_RETRIES=2

# 【可选】指数退避的基数秒数。默认 2.0，即重试间隔为 2s / 4s / 8s（逐次翻倍，上限 30s）。
#         本地测试想跳过等待可调小（如 0.1）；生产环境遇到激进限流可调大（如 5）。
LLM_RETRY_BASE_DELAY=2.0


# -----------------------------------------------------------------------------
#  二、PDF 解析配置
# -----------------------------------------------------------------------------

# 【可选】送入大模型的正文最大字符数。默认 60000。
#         超出部分会按页节选（每页保留页码锚点，摘要/结论相关页优先完整保留，
#         其余页均衡节选）；Prompt 中也会明确告知模型"只基于可见内容分析"。
#         上下文窗口够大的模型可以调大到 120000；调太大则费用与耗时都会上升。
MAX_INPUT_CHARS=60000

# 【可选】严格引用模式。默认 false。
#         设为 true 时：凡是无法在论文原文中逐字定位到的 evidence，一律清空，
#         宁可少给证据也不保留可能由模型编造的引用。追求"零幻觉"的场合可开启。
STRICT_CITATION=false


# -----------------------------------------------------------------------------
#  三、输出配置
# -----------------------------------------------------------------------------

# 【可选】默认输出 HTML 路径。留空时输出到 outputs/<论文文件名>.dashboard.html。
#         命令行 -o / --output 的优先级高于本项。
OUTPUT_HTML=

# 【可选】是否额外导出中间产物。默认 false。
#         设为 true 时会在 HTML 同级生成 <报告名>.debug/ 目录，内含：
#         01_parsed.json（解析结果）、02_analysis.json（模型结构化输出）、
#         03_diagram.mmd（Mermaid 源码）、04_payload.json（前端数据）、05_body.txt（正文全文）。
#         排查"解析不准 / 引用对不上"时非常有用。命令行 --keep-debug 等价。
KEEP_DEBUG=false


# -----------------------------------------------------------------------------
#  四、运行模式
# -----------------------------------------------------------------------------

# 【可选】离线演示模式。默认 false。
#         设为 true 时完全不调用大模型 API，导图内容来自本地样例 JSON，零费用。
#         命令行 --mock 等价。
MOCK=false

# 【可选】离线演示使用的分析 JSON 路径。留空时按顺序查找：
#         1) 输入 PDF 同目录下的 <论文名>.analysis.json 或 <论文名>.json
#         2) <项目根>/examples/sample_analysis.json
#         3) 内置兜底样例（src/llm.py 的 _builtin_analysis）
MOCK_FILE=

# 【可选】详细日志。默认 false。设为 true 时打印每一步的中间细节，
#         并在发生未预期异常时输出完整堆栈。命令行 -v / --verbose 等价。
VERBOSE=false


# =============================================================================
#  五、各服务商可直接复制的预设（示例值，请以服务商官方文档为准）
# =============================================================================
#
#  ⚠️ 下面每一组的 Base URL 与模型名都只是"示例"，服务商会随时新增/下线模型、
#     调整路径。使用前请对照该服务商控制台或官方文档确认一次。
#     用法：把某一组的三行复制到上面"一、大模型配置"处，覆盖 LLM_BASE_URL / LLM_MODEL。
#
# -----------------------------------------------------------------------------
# 【预设 1】DeepSeek 官方（本项目默认值，性价比高，中文论文分析够用）
#   申请入口：https://platform.deepseek.com/
#   文档    ：https://api-docs.deepseek.com/
# -----------------------------------------------------------------------------
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-pro
#
# -----------------------------------------------------------------------------
# 【预设 2】月之暗面 Kimi（Moonshot AI，长上下文见长，适合超长论文）
#   申请入口：https://platform.moonshot.cn/
#   文档    ：https://platform.moonshot.cn/docs
#   提示    ：kimi-k2 系列与 moonshot-v1-* 系列模型名不通用，请按控制台"模型列表"填写。
# -----------------------------------------------------------------------------
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=kimi-k2-0905-preview
#
# -----------------------------------------------------------------------------
# 【预设 3】阿里云通义千问 DashScope 兼容模式（百炼平台）
#   申请入口：https://bailian.console.aliyun.com/
#   文档    ：https://help.aliyun.com/zh/model-studio/compatibility-of-openai-with-dashscope
#   提示    ：必须是 compatible-mode 这个兼容路径，用原生 DashScope 路径会 404。
# -----------------------------------------------------------------------------
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
#
# -----------------------------------------------------------------------------
# 【预设 4】智谱 GLM（BigModel 开放平台）
#   申请入口：https://open.bigmodel.cn/
#   文档    ：https://docs.bigmodel.cn/
#   提示    ：路径后缀是 /api/paas/v4，不是 /v1。
# -----------------------------------------------------------------------------
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-plus
#
# -----------------------------------------------------------------------------
# 【预设 5】本地 Ollama（完全离线、零 API 费用，需要本机有足够显存/内存）
#   安装    ：https://ollama.com/download   然后 `ollama pull qwen2.5:7b`
#   提示    ：Base URL 必须带 /v1；LLM_API_KEY 随便填一个非空字符串占位即可
#             （Ollama 不校验密钥，但本程序会检查它非空）。
#             本地小模型对长 JSON 的输出稳定性弱于云端大模型，建议先用 --mock 验证链路。
# -----------------------------------------------------------------------------
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama
